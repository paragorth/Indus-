               <rdf:li xml:lang="x-default">RÃ³gvi N. Johansen&#xA;Foto/Medie afdelingen Moesgaard&#xA;MoesgÃ¥rd AllÃ© 20&#xA;DK-8270 HÃ¸jbjerg&#xA;&#xA;Tlf. (+45) 8942 4628 (Work)&#xA;Mobil. (+45) 2021 9290 (Work)&#xA;e-mail: rogvi.johansen@hum.au.dk</rdf:li>
            </rdf:Alt>
         </dc:rights>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">new indus seals</rdf:li>
            </rdf:Alt>
