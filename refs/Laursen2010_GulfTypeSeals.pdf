         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Very worn anl large Arabian gulf seal with indus style bull and indus script. Grey streatite With white "glaze" Dia 3,05cm, H more than 1,55cm probably 1,72cm, Boss 1,89cm, Disc 1,06cm. Found in: Al-Janabiah- land of Fasal Fariha Tell 675, main chamber (north east quarter) near entrance Season.</rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>RÃ³gvi N. Johansen</rdf:li>
            </rdf:Seq>
         </dc:creator>
