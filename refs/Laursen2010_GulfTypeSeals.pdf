         <dc:subject>
            <rdf:Bag>
               <rdf:li>Segl. Flemming HÃ¸jlund</rdf:li>
               <rdf:li>Steffen Terp Laursen</rdf:li>
               <rdf:li>Moesgaard Museum</rdf:li>
               <rdf:li>februar 2009</rdf:li>
